CONTEXTGO_DATABASE_PATH=/opt/contextgo-cloud/data/contextgo-cloud.db
CONTEXTGO_AUTH_BASE_URL=https://auth.contextgo.io
CONTEXTGO_API_BASE_URL=https://api.contextgo.io
CONTEXTGO_REMOTE_BASE_URL=https://remote.contextgo.io
CONTEXTGO_RENDERER_BUILD_ROOT=/opt/contextgo-cloud/out/renderer
CONTEXTGO_SESSION_COOKIE_DOMAIN=.contextgo.io

# Optional allowlist. Leave empty to allow any verified email.
CONTEXTGO_ALLOWED_EMAILS=

CONTEXTGO_GITHUB_CLIENT_ID=
CONTEXTGO_GITHUB_CLIENT_SECRET=
CONTEXTGO_GOOGLE_CLIENT_ID=
CONTEXTGO_GOOGLE_CLIENT_SECRET=

# InferMesh provider bootstrap. These can stay empty if you only use OIDC SSO.
CONTEXTGO_INFERMESH_API_BASE_URL=https://api.infermesh.org
CONTEXTGO_INFERMESH_CONSOLE_BASE_URL=https://newapi.infermesh.org
CONTEXTGO_INFERMESH_ADMIN_BASE_URL=https://newapi-admin.infermesh.org
CONTEXTGO_INFERMESH_ADMIN_USERNAME=
CONTEXTGO_INFERMESH_ADMIN_PASSWORD=
CONTEXTGO_INFERMESH_ADMIN_ACCESS_CLIENT_ID=
CONTEXTGO_INFERMESH_ADMIN_ACCESS_CLIENT_SECRET=
CONTEXTGO_INFERMESH_PASSWORD_SECRET=
CONTEXTGO_INFERMESH_USERNAME_PREFIX=cg
CONTEXTGO_INFERMESH_PROVIDER_NAME=InferMesh Cloud

# OIDC identity provider settings for InferMesh.
CONTEXTGO_OIDC_CLIENT_ID=infermesh-oidc-client
CONTEXTGO_OIDC_CLIENT_SECRET=
CONTEXTGO_OIDC_CLIENT_NAME=InferMesh
CONTEXTGO_OIDC_REDIRECT_URIS=https://newapi.infermesh.org/oauth/oidc,https://newapi-admin.infermesh.org/oauth/oidc

# PEM private key used to sign id_token. Keep the literal multiline PEM body.
CONTEXTGO_OIDC_SIGNING_KEY_PEM='-----BEGIN PRIVATE KEY-----
REPLACE_WITH_REAL_KEY
-----END PRIVATE KEY-----'
CONTEXTGO_OIDC_SIGNING_KEY_ID=contextgo-auth-1
