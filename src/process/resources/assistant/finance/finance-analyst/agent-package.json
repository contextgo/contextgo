        {
          "kind": "package-relative",
          "root": "docs"
        }
      ],
      "installSurface": "package-docs",
      "runtimeProjection": "none"
    },
    "skills": {
      "logicalId": "skills",
      "sources": [
        {
          "kind": "repo-relative",
          "root": "src/process/resources/skills/finance-analyst-pack"
