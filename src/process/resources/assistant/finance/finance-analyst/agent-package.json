{
  "protocolVersion": "agent-package.v1",
  "packageId": "finance-analyst",
  "assistantPresetId": "builtin-finance-analyst",
  "displayName": "Finance Analyst",
  "runtimeNeutral": true,
  "payloads": {
    "rules": {
      "logicalId": "rules",
      "sources": [
        {
          "kind": "package-relative",
          "root": "."
        }
      ],
      "files": {
        "en-US": "finance-analyst.md",
        "zh-CN": "finance-analyst.zh-CN.md"
      },
      "installSurface": "assistant-rules-cache",
      "runtimeProjection": "none"
    },
    "docs": {
      "logicalId": "docs",
