{
  "protocolVersion": "agent-package.v1",
  "packageId": "office-analyst",
  "assistantPresetId": "builtin-office-analyst",
  "displayName": "Office Analyst",
  "runtimeNeutral": true,
  "entryDocument": {
    "file": "AGENTS.md",
    "runtimeEntryProjections": [
      {
        "runtime": "claude",
        "target": "CLAUDE.md"
      },
      {
        "runtime": "gemini",
        "target": "GEMINI.md"
      }
    ]
  },
  "docsDirectory": {
    "root": "docs"
  },
  "payloads": {
    "workspaceScaffold": {
      "logicalId": "workspaceScaffold",
      "sources": [
        {
          "kind": "package-relative",
          "root": "workspace"
        }
      ],
      "installSurface": "workspace-root-docs",
      "runtimeProjection": "none",
      "focusAreas": [
        "spreadsheet and document analysis across multiple files",
        "source reconciliation and cross-file validation",
        "polished report assembly for durable reuse"
      ],
      "suggestedArtifacts": ["cleaned spreadsheets", "extracted notes", "reconciled findings", "draft reports"],
      "templates": [
        {
          "source": "workspace/AGENTS.md",
          "target": "AGENTS.md"
        },
        {
          "source": "workspace/docs/README.md",
          "target": "docs/README.md"
        },
        {
          "source": "workspace/docs/sources/README.md",
          "target": "docs/sources/README.md"
        },
        {
          "source": "workspace/docs/analysis/README.md",
          "target": "docs/analysis/README.md"
        },
        {
          "source": "workspace/docs/reports/README.md",
          "target": "docs/reports/README.md"
        }
      ]
    },
    "skills": {
      "logicalId": "skills",
      "sources": [
        {
          "kind": "repo-relative",
          "root": "src/process/resources/skills/office-analyst-pack"
        },
        {
          "kind": "repo-relative",
          "root": "removed-office-skill"
        },
        {
          "kind": "repo-relative",
          "root": "removed-office-skill"
        },
        {
          "kind": "repo-relative",
          "root": "removed-office-skill"
        }
      ],
      "installSurface": ".contextgo/skills",
      "runtimeProjection": "native-skills-only",
      "bootstrapStrategy": "enabled-skills",
      "defaultEnabledSkillNames": [
        "xlsx",
        "docx",
        "pdf",
        "office-spreadsheet-analysis",
        "office-document-operations",
        "office-source-reconciliation",
        "office-briefing",
        "office-report-drafting",
        "office-duckdb-query",
        "office-duckdb-read-file",
        "office-duckdb-install",
        "office-cross-file-join-analysis",
        "office-report-drilldown",
        "office-pdf-table-query"
      ],
      "packagedSkillNames": [
        "office-spreadsheet-analysis",
        "office-document-operations",
        "office-source-reconciliation",
        "office-briefing",
        "office-report-drafting",
        "office-duckdb-query",
        "office-duckdb-read-file",
        "office-duckdb-install",
        "office-cross-file-join-analysis",
        "office-report-drilldown",
        "office-pdf-table-query"
      ]
    },
    "commands": {
      "logicalId": "commands",
      "sources": [
        {
          "kind": "workspace-automation-profile",
          "root": "office-analyst"
        }
      ],
      "installSurface": ".contextgo/commands.json",
      "runtimeProjection": "none",
      "workspaceAutomationProfile": "office-analyst"
    },
    "schedules": {
      "logicalId": "schedules",
      "sources": [
        {
          "kind": "workspace-automation-profile",
          "root": "office-analyst"
        }
      ],
      "installSurface": ".contextgo/schedules.json",
      "runtimeProjection": "none",
      "workspaceAutomationProfile": "office-analyst"
    }
  }
}
