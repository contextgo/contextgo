{
  "protocolVersion": "agent-package.v1",
  "packageId": "superpowers",
  "assistantPresetId": "builtin-superpowers",
  "displayName": "Superpowers Harness",
  "runtimeNeutral": true,
  "entryDocument": {
    "file": "AGENTS.md",
    "runtimeEntryProjections": [
      {
        "runtime": "claude",
        "target": "CLAUDE.md"
      },
      {
        "runtime": "gemini",
        "target": "GEMINI.md"
      }
    ]
  },
  "docsDirectory": {
    "root": "docs"
  },
  "payloads": {
    "workspaceScaffold": {
      "logicalId": "workspaceScaffold",
      "sources": [
        {
          "kind": "package-relative",
          "root": "workspace"
        }
      ],
      "installSurface": "workspace-root-docs",
      "runtimeProjection": "none",
      "focusAreas": [
        "repository-based engineering delivery",
        "spec, plan, TDD, review, debugging, and verification workflows",
        "durable project artifacts tied to the workspace instead of ephemeral chat"
      ],
      "suggestedArtifacts": ["project overviews", "design specs", "implementation plans", "verification notes"],
      "templates": [
        {
          "source": "workspace/AGENTS.md",
          "target": "AGENTS.md"
        },
        {
          "source": "workspace/docs/README.md",
          "target": "docs/README.md"
        },
        {
          "source": "workspace/docs/plans/README.md",
          "target": "docs/plans/README.md"
        },
        {
          "source": "workspace/docs/specs/README.md",
          "target": "docs/specs/README.md"
        },
        {
          "source": "workspace/docs/reviews/README.md",
          "target": "docs/reviews/README.md"
        },
        {
          "source": "workspace/docs/testing.md",
          "target": "docs/testing.md"
        }
      ]
    },
    "skills": {
      "logicalId": "skills",
      "sources": [
        {
          "kind": "repo-relative",
          "root": "src/process/resources/skills/engineering-pack"
        }
      ],
      "installSurface": ".contextgo/skills",
      "runtimeProjection": "native-skills-only",
      "bootstrapStrategy": "enabled-skills",
      "defaultEnabledSkillNames": [
        "using-superpowers",
        "brainstorming",
        "writing-plans",
        "writing-skills",
        "executing-plans",
        "test-driven-development",
        "using-git-worktrees",
        "subagent-driven-development",
        "dispatching-parallel-agents",
        "finishing-a-development-branch",
        "requesting-code-review",
        "receiving-code-review",
        "systematic-debugging",
        "verification-before-completion"
      ],
      "packagedSkillNames": [
        "using-superpowers",
        "brainstorming",
        "writing-plans",
        "writing-skills",
        "executing-plans",
        "test-driven-development",
        "using-git-worktrees",
        "subagent-driven-development",
        "dispatching-parallel-agents",
        "finishing-a-development-branch",
        "requesting-code-review",
        "receiving-code-review",
        "systematic-debugging",
        "verification-before-completion"
      ],
      "hidePackageOwnedSkillsFromLibrary": true
    },
    "commands": {
      "logicalId": "commands",
      "sources": [
        {
          "kind": "workspace-automation-profile",
          "root": "contextgo-harness"
        }
      ],
      "installSurface": ".contextgo/commands.json",
      "runtimeProjection": "none",
      "workspaceAutomationProfile": "contextgo-harness"
    },
    "hooks": {
      "logicalId": "hooks",
      "sources": [
        {
          "kind": "repo-relative",
          "root": "src/process/resources/hooks"
        }
      ],
      "installSurface": ".contextgo/hooks/",
      "selectionSurface": ".contextgo/hooks.json",
      "runtimeProjection": "none",
      "defaultEnabledHookNames": [
        "repo-context-bootstrap",
        "plan-before-coding",
        "secret-guard",
        "tool-safety-guard",
        "quality-gate",
        "tdd-guard",
        "continuity-handoff"
      ]
    },
    "schedules": {
      "logicalId": "schedules",
      "sources": [
        {
          "kind": "workspace-automation-profile",
          "root": "contextgo-harness"
        }
      ],
      "installSurface": ".contextgo/schedules.json",
      "runtimeProjection": "none",
      "workspaceAutomationProfile": "contextgo-harness"
    }
  }
}
