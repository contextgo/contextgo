{
  "protocolVersion": "agent-package.v1",
  "packageId": "superpowers",
  "assistantPresetId": "builtin-superpowers",
  "displayName": "Superpowers Harness",
  "runtimeNeutral": true,
  "payloads": {
    "rules": {
      "logicalId": "rules",
      "sources": [
        {
          "kind": "package-relative",
          "root": "."
        }
      ],
      "files": {
        "en-US": "superpowers.md",
        "zh-CN": "superpowers.zh-CN.md"
      },
      "installSurface": "assistant-rules-cache",
      "runtimeProjection": "none"
    },
    "docs": {
      "logicalId": "docs",
      "sources": [
        {
          "kind": "package-relative",
          "root": "docs"
        }
      ],
      "installSurface": "package-docs",
      "runtimeProjection": "none"
    },
    "skills": {
      "logicalId": "skills",
      "sources": [
        {
          "kind": "repo-relative",
          "root": "src/process/resources/skills/engineering-pack"
        }
      ],
      "installSurface": ".contextgo/skills",
      "runtimeProjection": "native-skills-only",
      "bootstrapStrategy": "enabled-skills",
      "defaultEnabledSkillNames": [
        "using-superpowers",
        "brainstorming",
        "writing-plans",
        "writing-skills",
        "executing-plans",
        "test-driven-development",
        "using-git-worktrees",
        "subagent-driven-development",
        "dispatching-parallel-agents",
        "finishing-a-development-branch",
        "requesting-code-review",
        "receiving-code-review",
        "systematic-debugging",
        "verification-before-completion"
      ],
      "packagedSkillNames": [
        "using-superpowers",
        "brainstorming",
        "writing-plans",
        "writing-skills",
        "executing-plans",
        "test-driven-development",
        "using-git-worktrees",
        "subagent-driven-development",
        "dispatching-parallel-agents",
        "finishing-a-development-branch",
        "requesting-code-review",
        "receiving-code-review",
        "systematic-debugging",
        "verification-before-completion"
      ],
      "hidePackageOwnedSkillsFromLibrary": true
    },
    "commands": {
      "logicalId": "commands",
      "sources": [
        {
          "kind": "workspace-automation-profile",
          "root": "contextgo-harness"
        }
      ],
      "installSurface": ".contextgo/commands.json",
      "runtimeProjection": "none",
      "workspaceAutomationProfile": "contextgo-harness"
    },
    "hooks": {
      "logicalId": "hooks",
      "sources": [
        {
          "kind": "repo-relative",
          "root": "src/process/resources/hooks"
        }
      ],
      "installSurface": ".contextgo/hooks/",
      "selectionSurface": ".contextgo/hooks.json",
      "runtimeProjection": "none",
      "defaultEnabledHookNames": [
        "repo-context-bootstrap",
        "plan-before-coding",
        "secret-guard",
        "tool-safety-guard",
        "quality-gate",
        "tdd-guard",
        "continuity-handoff"
      ]
    },
    "schedules": {
      "logicalId": "schedules",
      "sources": [
        {
          "kind": "workspace-automation-profile",
          "root": "contextgo-harness"
        }
      ],
      "installSurface": ".contextgo/schedules.json",
      "runtimeProjection": "none",
      "workspaceAutomationProfile": "contextgo-harness"
    }
  }
}
