{
  "protocolVersion": "agent-package.v1",
  "packageId": "design-director",
  "assistantPresetId": "builtin-design-director",
  "displayName": "Design Director",
  "runtimeNeutral": true,
  "entryDocument": {
    "file": "AGENTS.md",
    "runtimeEntryProjections": [
      {
        "runtime": "claude",
        "target": "CLAUDE.md"
      },
      {
        "runtime": "gemini",
        "target": "GEMINI.md"
      }
    ]
  },
  "docsDirectory": {
    "root": "docs"
  },
  "payloads": {
    "workspaceScaffold": {
      "logicalId": "workspaceScaffold",
      "sources": [
        {
          "kind": "package-relative",
          "root": "workspace"
        }
      ],
      "installSurface": "workspace-root-docs",
      "runtimeProjection": "none",
      "focusAreas": [
        "visual direction, screenshot critique, and reference absorption",
        "project-level design system distillation",
        "implementation-ready design handoff"
      ],
      "suggestedArtifacts": ["DESIGN.md drafts", "art-direction briefs", "critique notes", "handoff specs"],
      "templates": [
        {
          "source": "workspace/AGENTS.md",
          "target": "AGENTS.md"
        },
        {
          "source": "workspace/docs/README.md",
          "target": "docs/README.md"
        },
        {
          "source": "workspace/docs/direction/README.md",
          "target": "docs/direction/README.md"
        },
        {
          "source": "workspace/docs/references/README.md",
          "target": "docs/references/README.md"
        },
        {
          "source": "workspace/docs/handoff/README.md",
          "target": "docs/handoff/README.md"
        }
      ]
    },
    "skills": {
      "logicalId": "skills",
      "sources": [
        {
          "kind": "repo-relative",
          "root": "src/process/resources/skills/design-director-pack"
        }
      ],
      "installSurface": ".contextgo/skills",
      "runtimeProjection": "native-skills-only",
      "bootstrapStrategy": "enabled-skills",
      "defaultEnabledSkillNames": [
        "design-style-archetype-selection",
        "design-system-distillation",
        "design-landing-page-art-direction",
        "design-product-surface-art-direction",
        "design-ui-critique-and-polish",
        "design-screenshot-critique",
        "design-figma-reference-absorption",
        "design-system-adaptation",
        "design-component-visual-spec",
        "design-handoff-brief"
      ],
      "packagedSkillNames": [
        "design-style-archetype-selection",
        "design-system-distillation",
        "design-landing-page-art-direction",
        "design-product-surface-art-direction",
        "design-ui-critique-and-polish",
        "design-screenshot-critique",
        "design-figma-reference-absorption",
        "design-system-adaptation",
        "design-component-visual-spec",
        "design-handoff-brief"
      ]
    },
    "commands": {
      "logicalId": "commands",
      "sources": [
        {
          "kind": "workspace-automation-profile",
          "root": "design-director"
        }
      ],
      "installSurface": ".contextgo/commands.json",
      "runtimeProjection": "none",
      "workspaceAutomationProfile": "design-director"
    },
    "schedules": {
      "logicalId": "schedules",
      "sources": [
        {
          "kind": "workspace-automation-profile",
          "root": "design-director"
        }
      ],
      "installSurface": ".contextgo/schedules.json",
      "runtimeProjection": "none",
      "workspaceAutomationProfile": "design-director"
    }
  }
}
