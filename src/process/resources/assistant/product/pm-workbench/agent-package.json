{
  "protocolVersion": "agent-package.v1",
  "packageId": "pm-workbench",
  "assistantPresetId": "builtin-pm-workbench",
  "displayName": "PM Workbench",
  "runtimeNeutral": true,
  "entryDocument": {
    "file": "AGENTS.md",
    "runtimeEntryProjections": [
      {
        "runtime": "claude",
        "target": "CLAUDE.md"
      },
      {
        "runtime": "gemini",
        "target": "GEMINI.md"
      }
    ]
  },
  "docsDirectory": {
    "root": "docs"
  },
  "payloads": {
    "workspaceScaffold": {
      "logicalId": "workspaceScaffold",
      "sources": [
        {
          "kind": "package-relative",
          "root": "workspace"
        }
      ],
      "installSurface": "workspace-root-docs",
      "runtimeProjection": "none",
      "focusAreas": [
        "evidence-led product discovery and problem framing",
        "PRD drafting, prioritization, and roadmap sequencing",
        "durable product decision records"
      ],
      "suggestedArtifacts": ["discovery notes", "PRDs", "prioritization tables", "roadmap artifacts"],
      "templates": [
        {
          "source": "workspace/AGENTS.md",
          "target": "AGENTS.md"
        },
        {
          "source": "workspace/docs/README.md",
          "target": "docs/README.md"
        },
        {
          "source": "workspace/docs/discovery/README.md",
          "target": "docs/discovery/README.md"
        },
        {
          "source": "workspace/docs/prds/README.md",
          "target": "docs/prds/README.md"
        },
        {
          "source": "workspace/docs/roadmap/README.md",
          "target": "docs/roadmap/README.md"
        }
      ]
    },
    "skills": {
      "logicalId": "skills",
      "sources": [
        {
          "kind": "repo-relative",
          "root": "src/process/resources/skills/pm-workbench-pack"
        }
      ],
      "installSurface": ".contextgo/skills",
      "runtimeProjection": "native-skills-only",
      "bootstrapStrategy": "enabled-skills",
      "defaultEnabledSkillNames": [
        "pm-product-strategy",
        "pm-discovery-process",
        "pm-opportunity-solution-tree",
        "pm-prd-development",
        "pm-roadmap-planning",
        "pm-prioritization-advisor",
        "pm-feature-investment-advisor",
        "pm-user-story-mapping",
        "pm-company-research"
      ],
      "packagedSkillNames": [
        "pm-product-strategy",
        "pm-discovery-process",
        "pm-opportunity-solution-tree",
        "pm-prd-development",
        "pm-roadmap-planning",
        "pm-prioritization-advisor",
        "pm-feature-investment-advisor",
        "pm-user-story-mapping",
        "pm-company-research"
      ]
    },
    "commands": {
      "logicalId": "commands",
      "sources": [
        {
          "kind": "workspace-automation-profile",
          "root": "pm-workbench"
        }
      ],
      "installSurface": ".contextgo/commands.json",
      "runtimeProjection": "none",
      "workspaceAutomationProfile": "pm-workbench"
    },
    "schedules": {
      "logicalId": "schedules",
      "sources": [
        {
          "kind": "workspace-automation-profile",
          "root": "pm-workbench"
        }
      ],
      "installSurface": ".contextgo/schedules.json",
      "runtimeProjection": "none",
      "workspaceAutomationProfile": "pm-workbench"
    }
  }
}
