{
  "compilerOptions": {
    "target": "ES6",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "jsx": "react",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@process/*": [
        "./src/process/*"
      ],
      "@renderer/*": [
        "./src/renderer/*"
      ],
      "@worker/*": [
        "./src/process/worker/*"
      ],
      "@blocksuite/affine/shared/services": [
        "./src/renderer/pages/space/affine/vendor/affineSharedServicesShim.d.ts"
      ],
      "@blocksuite/affine/std/gfx": [
        "./src/renderer/pages/space/affine/vendor/affineStdGfxShim.d.ts"
      ],
      "@blocksuite/affine/store": [
        "./src/renderer/pages/space/affine/vendor/affineStoreShim.d.ts"
      ],
      "@blocksuite/affine/store/test": [
        "./src/renderer/pages/space/affine/vendor/affineStoreTestShim.d.ts"
      ],
      "@blocksuite/affine/ext-loader": [
        "./src/renderer/pages/space/affine/vendor/affineExtLoaderShim.d.ts"
      ],
      "@blocksuite/affine/extensions/store": [
        "./src/renderer/pages/space/affine/vendor/affineExtensionsStoreShim.d.ts"
      ],
      "@blocksuite/affine/extensions/view": [
        "./src/renderer/pages/space/affine/vendor/affineExtensionsViewShim.d.ts"
      ],
      "@blocksuite/affine/effects": [
        "./src/renderer/pages/space/affine/vendor/affineEffectsShim.d.ts"
      ],
      "@blocksuite/affine/global/lit": [
        "./src/renderer/pages/space/affine/vendor/affineGlobalLitShim.d.ts"
      ],
      "@blocksuite/affine/std": [
        "./src/renderer/pages/space/affine/vendor/affineStdShim.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "uno.config.ts",
    "electron.vite.config.ts",
    "playwright.config.ts",
    "src/renderer/types.d.ts"
  ],
  "exclude": [
    "src/process/services/database/drivers/BunSqliteDriver.ts",
    "src/process/services/database/drivers/BunSqliteDriver.bun.test.ts"
  ]
}
